[{"id":"mww7eik7","body":"Ἰδὲ γὰρ ἀνθρώπους οἷον ἐν καταγείῳ οἰκήσει σπηλαιώδει, ἀναπεπταμένην πρὸς τὸ φῶς τὴν εἴσοδον ἔχουσῃ μακρὰν παρὰ πᾶν τὸ σπήλαιον, ἐν ταύτῃ ἐκ παίδων ὄντας ἐν δεσμοῖς.\n\nκαὶ τὰ σκέλη καὶ τοὺς αὐχένας ὥστε μένειν τε αὐτοὺς εἰς τὸ πρόσθεν μόνον ὁρᾶν, κύκλῳ δὲ τὰς κεφαλὰς ὑπὸ τοῦ δεσμοῦ ἀδυνάτους περιάγειν.\n\nφῶς δὲ αὐτοῖς πυρὸς ἄνωθεν καὶ πόρρωθεν καόμενον ὄπισθεν αὐτῶν, μεταξὺ δὲ τοῦ πυρὸς καὶ τῶν δεσμωτῶν ἐπάνω ὁδόν, παρ’ ἣν ἰδὲ τειχίον παρῳκοδομημένον.","parses":{"0":{"w":"Ἰδὲ","pos":"verb","vform":"finite","tense":"aor.","mood":"impv.","voice":"act.","person":"2nd","number":"sg.","role":"predicate","lemma":"ὁράω (aor. εἶδον)","gloss":"смотри, представь","note":"сильный аорист"},"1":{"w":"γὰρ","pos":"conjunction","lemma":"γάρ","gloss":"ведь, ибо"},"2":{"w":"ἀνθρώπους","pos":"noun","case":"Acc.","number":"pl.","gender":"masc.","role":"object","lemma":"ἄνθρωπος, -ου, ὁ","gloss":"человек","note":"объект ἰδέ"},"3":{"w":"οἷον","pos":"adverb","lemma":"οἷον","gloss":"как бы, словно"},"4":{"w":"ἐν","pos":"preposition","gov":"+ Dat.","role":"adverbial","lemma":"ἐν","gloss":"в"},"5":{"w":"καταγείῳ","pos":"adjective","case":"Dat.","number":"sg.","gender":"fem.","role":"attribute","lemma":"κατάγειος, -ον","gloss":"подземный","note":"прил. двух окончаний"},"6":{"w":"οἰκήσει","pos":"noun","case":"Dat.","number":"sg.","gender":"fem.","role":"adverbial","lemma":"οἴκησις, -εως, ἡ","gloss":"жилище","note":"где? место"},"7":{"w":"σπηλαιώδει","pos":"adjective","case":"Dat.","number":"sg.","gender":"fem.","role":"attribute","lemma":"σπηλαιώδης, -ες","gloss":"похожий на пещеру","note":"III скл."},"8":{"w":"ἀναπεπταμένην","pos":"verb","vform":"participle","tense":"perf.","voice":"mid./pass.","case":"Acc.","number":"sg.","gender":"fem.","role":"attribute","lemma":"ἀναπετάννυμι","gloss":"распахнутый","note":"к εἴσοδον, предикативно"},"9":{"w":"πρὸς","pos":"preposition","gov":"+ Acc.","role":"adverbial","lemma":"πρός","gloss":"к, в сторону"},"10":{"w":"τὸ","pos":"a